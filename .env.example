# Copy to .env and fill in. Never commit .env.

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- LLM (OpenRouter) ---
# Paid, on a key with a hard spend cap set in the OpenRouter dashboard -
# real per-call cost is a few millionths of a dollar (verify via
# GET https://openrouter.ai/api/v1/models, "tools" in supported_parameters,
# before switching). Use a free ":free" model instead if you'd rather not
# add a paid key at all - app/config.py's default only applies when this
# is left unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# --- State store ---
# memory | sqlite | redis   (sqlite is the zero-dependency default for demos)
STATE_STORE=sqlite
STATE_TTL_DAYS=7
REDIS_URL=redis://localhost:6379/0

# --- Turso / libSQL (only used when set) ---
# Leave blank for local dev - every store falls back to SQLite/JSONL under
# data/, no external service needed. Set both only when deploying (e.g. to
# Vercel, whose filesystem is ephemeral/read-only) - create a free database
# at https://turso.tech (or via the Vercel Marketplace) and copy its URL +
# auth token from `turso db show <name>` / `turso db tokens create <name>`.
# IMPORTANT: use the https:// form of the URL, not libsql:// - the CLI/
# dashboard usually give you libsql://, which libsql-client maps to a
# WebSocket connection that fails on Vercel's serverless networking (400
# on the WS handshake). https://<db>-<org>.turso.io uses libsql-client's
# plain-HTTP path instead, which works there.
DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Outbound messaging ---
# console | whatsapp   (console echoes messages to stdout + audit log)
NOTIFY_CHANNEL=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Agent guardrails ---
MAX_GATE_CORRECTIONS=3

# --- Voice channel (see docs/voice.md) ---
# Phase 1 (the deterministic gate/dialogue/verify/session architecture,
# text-simulated turns at /voice) needs none of these. Phase 2 (real
# speech over a browser WebRTC call) needs SARVAM_API_KEY plus
# `pip install -e ".[voice]"`. Phase 3 (ringing a real phone via Plivo)
# additionally needs the PLIVO_* vars and PUBLIC_BASE_URL.
SARVAM_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PUBLIC_BASE_URL=
