# Copy to .env and fill in. Never commit .env.

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- LLM (OpenRouter) ---
# Free-tier only. Verify current free + tool-capable models via
# GET https://openrouter.ai/api/v1/models before changing (pricing.prompt
# == "0" and "tools" in supported_parameters) - the free lineup rotates.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- State store ---
# memory | sqlite | redis   (sqlite is the zero-dependency default for demos)
STATE_STORE=sqlite
STATE_TTL_DAYS=7
REDIS_URL=redis://localhost:6379/0

# --- Turso / libSQL (only used when set) ---
# Leave blank for local dev - every store falls back to SQLite/JSONL under
# data/, no external service needed. Set both only when deploying (e.g. to
# Vercel, whose filesystem is ephemeral/read-only) - create a free database
# at https://turso.tech (or via the Vercel Marketplace) and copy its URL +
# auth token from `turso db show <name>` / `turso db tokens create <name>`.
DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Outbound messaging ---
# console | whatsapp   (console echoes messages to stdout + audit log)
NOTIFY_CHANNEL=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Agent guardrails ---
MAX_GATE_CORRECTIONS=3
